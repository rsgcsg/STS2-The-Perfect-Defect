# Non-secret deployment configuration. Put the real file outside the repository.
# Use raw values without shell expressions. Never source an env file into a shell.
STPD_WORKER_IMAGE=registry.example/stpd@sha256:REPLACE_WITH_REVIEWED_DIGEST
STPD_CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE_WITH_REVIEWED_DIGEST
STPD_HUB_DOMAIN=hub.example.org
STPD_ACME_EMAIL=operator@example.org
STPD_HUB_STATE_DIR=/srv/stpd/hub
STPD_HUB_CADDY_DIR=/srv/stpd/caddy
STPD_HUB_SECRET_FILE=/etc/stpd/hub-runtime.env
STPD_HUB_BUDGET_UNITS=0
