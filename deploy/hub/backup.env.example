# Separate operator credential, scoped only to a THIRD private backup bucket.
# Never inject this file into the always-running Hub or a collector/compute worker.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STPD_S3_ENDPOINT=
STPD_S3_REGION=auto
STPD_BACKUP_BUCKET=
# Optional short-lived SDK credential:
# AWS_SESSION_TOKEN=
