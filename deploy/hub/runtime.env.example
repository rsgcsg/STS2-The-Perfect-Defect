# KEY names only: human/admin supplies values in an external mode-0600 file.
# Compose reads this file with format: raw (Compose >=2.30). No quoting or interpolation.
STPD_HUB_ADMIN_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STPD_S3_ENDPOINT=
STPD_S3_REGION=auto
STPD_S3_BUCKET=
STPD_S3_PREFIX=stpd
STPD_INGRESS_BUCKET=
# Optional short-lived SDK credential:
# AWS_SESSION_TOKEN=
# Optional SAME-Hub scheduler, only after exact target/account/budget qualification.
# Leave all three commented for upload-only operation (default budget remains zero).
# STPD_MODAL_TARGET=/var/lib/stpd/modal-target.json
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Match the environment used for the worker deployment and storage Secret.
# MODAL_ENVIRONMENT=spireagent-b

# Optional read-only browser console. All three must be configured together.
# The allowlist is a separate private uid-10001 JSON file in the mounted state directory.
# STPD_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
# STPD_ACCESS_AUDIENCE=EXACT_ACCESS_APPLICATION_AUD_64_HEX
# STPD_ACCESS_ALLOWLIST=/var/lib/stpd/console-access.json
# Optional existing backup-owner status projection, readable by uid 10001:
# STPD_HUB_BACKUP_STATUS=/var/lib/stpd/maintenance/backup-status.json
