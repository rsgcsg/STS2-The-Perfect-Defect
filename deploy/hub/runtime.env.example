# KEY names only: human/admin supplies values in an external mode-0600 file.
# Compose reads this file with format: raw (Compose >=2.30). No quoting or interpolation.
STPD_HUB_ADMIN_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STPD_S3_ENDPOINT=
STPD_S3_REGION=auto
STPD_S3_BUCKET=
STPD_S3_PREFIX=stpd
STPD_INGRESS_BUCKET=
# Optional short-lived SDK credential:
# AWS_SESSION_TOKEN=
# Optional SAME-Hub scheduler, only after exact target/account/budget qualification.
# Leave all three commented for upload-only operation (default budget remains zero).
# STPD_MODAL_TARGET=/var/lib/stpd/modal-target.json
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
