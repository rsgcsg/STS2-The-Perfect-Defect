{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-transition-v0.schema.json",
  "title": "STPD Research Transition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transition_id",
    "episode_id",
    "step_index",
    "seed",
    "environment",
    "policy",
    "input_profile",
    "eligibility",
    "state",
    "legal_actions",
    "chosen_action",
    "successor",
    "terminal",
    "outcome"
  ],
  "properties": {
    "schema": {"const": "stpd/research-transition-v0"},
    "transition_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "step_index": {"type": "integer", "minimum": 0},
    "seed": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/environmentIdentity"},
    "policy": {"$ref": "#/$defs/policyProvenance"},
    "input_profile": {
      "enum": [
        "stpd-combat-v0-lite",
        "stpd-combat-v0-standard",
        "stpd-combat-v0-full"
      ]
    },
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "state": {"type": "object"},
    "legal_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "chosen_action": {"type": "object"},
    "successor": {
      "oneOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "terminal": {"type": "boolean"},
    "outcome": {
      "oneOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_version",
        "game_commit",
        "host_source_revision",
        "host_artifact_sha256",
        "connector_version",
        "connector_artifact_sha256",
        "information_policy_id"
      ],
      "properties": {
        "game_version": {"type": "string", "minLength": 1},
        "game_commit": {"type": "string", "minLength": 1},
        "host_source_revision": {"type": "string", "minLength": 1},
        "host_artifact_sha256": {"type": "string", "minLength": 1},
        "connector_version": {"type": "string", "minLength": 1},
        "connector_artifact_sha256": {"type": "string", "minLength": 1},
        "information_policy_id": {"type": "string", "minLength": 1}
      }
    },
    "policyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "teacher_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "transition", "return"],
      "properties": {
        "rank": {"type": "boolean"},
        "transition": {"type": "boolean"},
        "return": {"type": "boolean"}
      }
    }
  }
}
