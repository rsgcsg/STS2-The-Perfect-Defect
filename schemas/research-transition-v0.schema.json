{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-transition-v0.schema.json",
  "title": "STPD Research Transition v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transition_id", "episode_id", "step_index", "seed", "environment", "policy", "decision_mode", "surface", "input_profile", "eligibility", "state", "legal_actions", "chosen_action", "successor", "terminal", "scope_exit", "outcome", "raw_ref"],
  "properties": {
    "schema": {"const": "stpd/research-transition-v0"},
    "transition_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "step_index": {"type": "integer", "minimum": 0},
    "seed": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/environmentIdentity"},
    "policy": {"$ref": "#/$defs/policyProvenance"},
    "decision_mode": {"const": "combat"},
    "surface": {"type": "string", "minLength": 1},
    "input_profile": {"enum": ["stpd-combat-v0-lite", "stpd-combat-v0-standard", "stpd-combat-v0-full"]},
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "state": {"$ref": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-state-v0.schema.json"},
    "legal_actions": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-action-v0.schema.json"}},
    "chosen_action": {"$ref": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-action-v0.schema.json"},
    "successor": {"oneOf": [{"$ref": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/research-state-v0.schema.json"}, {"type": "null"}]},
    "terminal": {"type": "boolean"},
    "scope_exit": {"type": "boolean"},
    "outcome": {"type": ["object", "null"]},
    "raw_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_version", "game_commit", "game_artifact_sha256", "game_artifact_mvid", "host_kind", "host_source_revision", "host_source_digest_sha256", "host_artifact_sha256", "host_artifact_mvid", "player_environment_protocol", "player_environment_implementation", "player_environment_revision", "player_environment_digest_sha256", "information_policy_id"],
      "properties": {
        "game_version": {"type": "string", "minLength": 1},
        "game_commit": {"type": "string", "minLength": 1},
        "game_artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "game_artifact_mvid": {"type": "string", "format": "uuid"},
        "host_kind": {"type": "string", "minLength": 1},
        "host_source_revision": {"type": "string", "minLength": 1},
        "host_source_digest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "host_artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "host_artifact_mvid": {"type": "string", "format": "uuid"},
        "player_environment_protocol": {"type": "string", "minLength": 1},
        "player_environment_implementation": {"type": "string", "minLength": 1},
        "player_environment_revision": {"type": "string", "minLength": 1},
        "player_environment_digest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "information_policy_id": {"type": "string", "minLength": 1}
      }
    },
    "policyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "config_hash", "teacher_confidence"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "minLength": 1},
        "teacher_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "rank_mode", "transition", "return", "legal_action_completeness", "reason_codes"],
      "properties": {
        "rank": {"type": "boolean"},
        "rank_mode": {"enum": ["full_listwise", "partial_pairwise", "chosen_only", "none"]},
        "transition": {"type": "boolean"},
        "return": {"type": "boolean"},
        "legal_action_completeness": {"enum": ["complete", "partial", "unknown"]},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
