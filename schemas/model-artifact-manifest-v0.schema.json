{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/model-artifact-manifest-v0.schema.json",
  "title": "STPD Model Artifact Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "created_at",
    "source_revision",
    "experiment_id",
    "architecture_id",
    "input_profile",
    "backbone",
    "files",
    "data_manifests",
    "metrics",
    "compatibility",
    "non_claims"
  ],
  "properties": {
    "schema": {"const": "stpd/model-artifact-manifest-v0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "architecture_id": {"type": "string", "minLength": 1},
    "input_profile": {"type": "string", "minLength": 1},
    "backbone": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "data_manifests": {
      "type": "array",
      "items": {"type": "object"}
    },
    "metrics": {"type": "object"},
    "compatibility": {"type": "object"},
    "non_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
