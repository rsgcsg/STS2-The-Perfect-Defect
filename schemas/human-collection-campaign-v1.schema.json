{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsgcsg.github.io/stpd/schemas/human-collection-campaign-v1.schema.json",
  "title": "STPD Human Collection Campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "collection_profile_id",
    "target_accepted_records",
    "scope",
    "allowed_workers",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "stpd/human-collection-campaign-v1"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "collection_profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "target_accepted_records": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "minLength": 1},
    "allowed_workers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
