{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/human-corpus-combination-v1.schema.json",
  "title": "STPD Human Corpus Combination v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "combination_id",
    "target_accepted_records",
    "created_at",
    "research_contract_schema",
    "player_environment_protocol",
    "connector_source_digest_sha256",
    "record_schema",
    "allowed_action_families",
    "admitted_profiles"
  ],
  "properties": {
    "schema": { "const": "stpd/human-corpus-combination-v1" },
    "combination_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "target_accepted_records": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "research_contract_schema": { "const": "stpd/research-transition-v0" },
    "player_environment_protocol": { "type": "string", "minLength": 1 },
    "connector_source_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record_schema": { "type": "string", "minLength": 1 },
    "serializer_version": {
      "enum": ["stpd-model-serialization-v0", "stpd-model-serialization-v1"]
    },
    "allowed_action_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "admitted_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "profile_sha256"],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
          "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
