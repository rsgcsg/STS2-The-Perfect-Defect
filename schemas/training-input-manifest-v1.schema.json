{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/training-input-manifest-v1.schema.json",
  "title": "STPD Training Input Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lane", "source_dataset", "model_view", "consumer", "derived_feature_artifact", "objects", "training_authorized", "authorization_owner", "retention", "non_claims", "training_input_id"],
  "properties": {
    "schema": {"const": "stpd/training-input-manifest-v1"},
    "lane": {"type": "string", "minLength": 1},
    "source_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_sha256", "semantic_dataset_hash", "rows"],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "model_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serializer_version", "input_profile", "qwen_identity"],
      "properties": {
        "serializer_version": {"type": "string", "minLength": 1},
        "input_profile": {"type": "string", "minLength": 1},
        "qwen_identity": {"type": "object", "minProperties": 1}
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_revision", "uv_lock_sha256", "entry_point"],
      "properties": {
        "repository": {"const": "rsgcsg/STS2-The-Perfect-Defect"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "uv_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry_point": {"type": "string", "minLength": 1}
      }
    },
    "derived_feature_artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "feature_spec_id", "manifest_content_id", "manifest_logical_path", "shape", "sample_count"],
          "properties": {
            "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "feature_spec_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "manifest_content_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "manifest_logical_path": {"type": "string", "minLength": 1},
            "shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false},
            "sample_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_path", "artifact_class", "role", "sha256", "bytes"],
        "properties": {
          "logical_path": {"type": "string", "minLength": 1},
          "artifact_class": {"enum": ["CANONICAL_RESEARCH", "DERIVED_MODEL_VIEW", "DERIVED_FEATURE_CACHE"]},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "training_authorized": {"const": false},
    "authorization_owner": {"type": "string", "minLength": 1},
    "retention": {"type": "object"},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "training_input_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
