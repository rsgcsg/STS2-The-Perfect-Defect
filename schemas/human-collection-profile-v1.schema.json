{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsgcsg.github.io/stpd/schemas/human-collection-profile-v1.schema.json",
  "title": "STPD Human Collection Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "platform",
    "game",
    "connector",
    "annotator",
    "player_environment_protocol",
    "modset",
    "record_schema",
    "allowed_action_families"
  ],
  "properties": {
    "schema": {"const": "stpd/human-collection-profile-v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "platform": {"type": "string", "minLength": 1},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "main_assembly_sha256", "main_assembly_mvid"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "main_assembly_sha256": {"$ref": "#/$defs/sha256"},
        "main_assembly_mvid": {"$ref": "#/$defs/uuid"}
      }
    },
    "connector": {"$ref": "#/$defs/artifact"},
    "annotator": {"$ref": "#/$defs/artifact"},
    "player_environment_protocol": {"type": "string", "minLength": 1},
    "modset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fingerprint"],
      "properties": {
        "status": {"const": "canary_exact_observer_modset"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "record_schema": {"const": "sts2.human-annotator/decision-record-1"},
    "allowed_action_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "source_digest_sha256", "artifact_sha256", "mvid"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_digest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "mvid": {"$ref": "#/$defs/uuid"}
      }
    }
  }
}
