{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsgcsg/STS2-The-Perfect-Defect/schemas/data-manifest-v0.schema.json",
  "title": "STPD Data Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "created_at", "source_revision", "contract_schema", "sources", "files", "row_count", "split", "deduplication", "eligibility_counts", "truncation_applied", "non_claims"],
  "properties": {
    "schema": {"const": "stpd/data-manifest-v0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "contract_schema": {"const": "stpd/research-transition-v0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "source_revision", "license_spdx", "provenance_uri"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "license_spdx": {"type": "string", "minLength": 1},
          "provenance_uri": {"type": "string", "minLength": 1}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "rows", "semantic_hash"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "rows": {"type": "integer", "minimum": 1},
          "semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "row_count": {"type": "integer", "minimum": 1},
    "split": {"type": "object"},
    "deduplication": {"type": "object"},
    "eligibility_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "truncation_applied": {"const": false},
    "non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
